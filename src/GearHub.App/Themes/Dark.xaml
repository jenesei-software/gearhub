<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Тёмная тема Windows 11 (цвета статусов — системные Fluent-палитры) -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F22B2B2B" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="AccentYellowBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="#FF99A4" />

    <DropShadowEffect x:Key="PanelShadow" BlurRadius="28" ShadowDepth="2" Opacity="0.55" Color="#000000" />

</ResourceDictionary>
