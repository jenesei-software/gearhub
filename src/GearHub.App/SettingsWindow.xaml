<Window x:Class="GearHub.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GearHub.App.Localization"
        Title="{loc:Loc SettingsWindowTitle}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Small section header -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>

        <!-- Option button (Max/Min, screen corners) -->
        <Style x:Key="PillRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                CornerRadius="6"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                Padding="12,6"
                                MinWidth="104">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 style toggle switch -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track"
                                    Width="36"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="{DynamicResource ButtonHoverBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1">
                                <Ellipse x:Name="Knob"
                                         Width="12"
                                         Height="12"
                                         Fill="{DynamicResource TextSecondaryBrush}"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Knob" Property="Fill" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            Padding="10,8"
            MinWidth="264"
            Effect="{DynamicResource PanelShadow}">
        <StackPanel>

            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xE8BB;"
                        ToolTip="{loc:Loc SettingsClose}"
                        Click="OnCloseClick" />
                <TextBlock Text="{loc:Loc SettingsTitle}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="2,0,0,0" />
            </DockPanel>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc SectionDisplay}" />
            <WrapPanel>
                <RadioButton Style="{StaticResource PillRadioStyle}"
                             GroupName="Mode"
                             Content="{loc:Loc ModeMax}"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Max, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource PillRadioStyle}"
                             GroupName="Mode"
                             Content="{loc:Loc ModeMin}"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Min, Mode=TwoWay}" />
            </WrapPanel>

            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                      Content="{loc:Loc AlwaysOnTop}"
                      Margin="2,6,0,0"
                      IsChecked="{Binding Topmost, Mode=TwoWay}" />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc SectionPosition}" Margin="2,16,0,6" />
            <WrapPanel MaxWidth="240">
                <RadioButton Style="{StaticResource PillRadioStyle}"
                             GroupName="Anchor"
                             Content="{loc:Loc AnchorTopLeft}"
                             IsChecked="{Binding Anchor, Converter={StaticResource EnumToBool}, ConverterParameter=TopLeft, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource PillRadioStyle}"
                             GroupName="Anchor"
                             Content="{loc:Loc AnchorTopRight}"
                             IsChecked="{Binding Anchor, Converter={StaticResource EnumToBool}, ConverterParameter=TopRight, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource PillRadioStyle}"
                             GroupName="Anchor"
                             Content="{loc:Loc AnchorBottomLeft}"
                             IsChecked="{Binding Anchor, Converter={StaticResource EnumToBool}, ConverterParameter=BottomLeft, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource PillRadioStyle}"
                             GroupName="Anchor"
                             Content="{loc:Loc AnchorBottomRight}"
                             IsChecked="{Binding Anchor, Converter={StaticResource EnumToBool}, ConverterParameter=BottomRight, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource PillRadioStyle}"
                             GroupName="Anchor"
                             Content="{loc:Loc AnchorFree}"
                             IsChecked="{Binding Anchor, Converter={StaticResource EnumToBool}, ConverterParameter=Free, Mode=TwoWay}" />
            </WrapPanel>

        </StackPanel>
    </Border>
</Window>
