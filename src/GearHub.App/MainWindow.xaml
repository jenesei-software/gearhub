<Window x:Class="GearHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GearHub.App.Localization"
        xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
        xmlns:vm="clr-namespace:GearHub.App.ViewModels"
        Title="GearHub"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        MaxWidth="420"
        MaxHeight="640"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate x:Key="DeviceCardTemplate" DataType="{x:Type vm:DeviceViewModel}">
            <Border x:Name="Card"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="10,7"
                    Margin="4">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{loc:Loc Ignore}" Command="{Binding IgnoreCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StatusDot"
                             Grid.Column="0"
                             Width="8"
                             Height="8"
                             Fill="{DynamicResource AccentGreenBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   MaxWidth="210"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding BatteryText}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Status}" Value="Attention">
                    <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource AccentYellowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Lost">
                    <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource AccentRedBrush}" />
                    <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Compact mode: device glyph and percentage (two full-width columns) -->
        <DataTemplate x:Key="DeviceCompactTemplate" DataType="{x:Type vm:DeviceViewModel}">
            <Border x:Name="CompactCard"
                    CornerRadius="6"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="10,6"
                    Margin="4">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{loc:Loc Ignore}" Command="{Binding IgnoreCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CompactIcon"
                               Grid.Column="0"
                               Text="{Binding KindGlyph}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{DynamicResource AccentGreenBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding BatteryText}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12"
                               Margin="8,0,0,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="CompactCard" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CompactCard" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Status}" Value="Attention">
                    <Setter TargetName="CompactIcon" Property="Foreground" Value="{DynamicResource AccentYellowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Lost">
                    <Setter TargetName="CompactIcon" Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
                    <Setter TargetName="CompactCard" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="Root"
                CornerRadius="8"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                Padding="6,5"
                ToolTip="{Binding StatusLine}"
                Effect="{DynamicResource PanelShadow}"
                MouseEnter="OnRootMouseEnter"
                MouseLeave="OnRootMouseLeave">
            <DockPanel>

                <!-- Button toolbar: appears on hover, the block grows by its height -->
                <StackPanel x:Name="Toolbar"
                            DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Margin="0,0,0,4">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE713;"
                            ToolTip="{loc:Loc TooltipSettings}"
                            Click="OnSettingsClick" />
                    <Button ToolTip="{loc:Loc TooltipRefreshNow}"
                            Margin="2,0,0,0"
                            Click="OnRefreshClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE72C;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RefreshDone}" Value="True">
                                            <Setter Property="Text" Value="&#xE73E;" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="RefreshSpin">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0"
                                                                         To="360"
                                                                         Duration="0:0:0.9"
                                                                         RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="RefreshSpin" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE8BB;"
                            ToolTip="{loc:Loc TooltipHideToTray}"
                            Margin="2,0,0,0"
                            Click="OnHideClick" />
                    <TextBlock Text="{Binding RefreshStatusText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RefreshStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="560"
                                  Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Devices}"
                                      ItemTemplate="{StaticResource DeviceCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="560"
                                  Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Devices}"
                                      ItemTemplate="{StaticResource DeviceCompactTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{loc:Loc NoDevicesFound}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="20,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDevices}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

            </DockPanel>
        </Border>

        <!-- The icon is assigned by code (UpdateTrayIcon): light on a dark taskbar, dark on a light one. -->
        <!-- Three behaviors: click — mini card, double click — bar, right click — the menu. -->
        <tb:TaskbarIcon x:Name="Tray"
                        ToolTipText="GearHub"
                        TrayLeftMouseUp="OnTrayLeftMouseUp"
                        TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:Loc TrayMenuShowHide}" Click="OnToggleWindowClick" />
                    <MenuItem Header="{loc:Loc TrayMenuRefresh}" Click="OnRefreshClick" />
                    <Separator />
                    <MenuItem Header="{loc:Loc TrayMenuExit}" Click="OnExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
