<Window x:Class="GearHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
        xmlns:vm="clr-namespace:GearHub.App.ViewModels"
        Title="GearHub"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        MaxWidth="420"
        MaxHeight="640"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate x:Key="DeviceCardTemplate" DataType="{x:Type vm:DeviceViewModel}">
            <Border x:Name="Card"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="10,7"
                    Margin="4">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Игнорировать" Command="{Binding IgnoreCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StatusDot"
                             Grid.Column="0"
                             Width="8"
                             Height="8"
                             Fill="{DynamicResource AccentGreenBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   MaxWidth="180"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10.5"
                                   MaxWidth="180"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BatteryGlyph}"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                        <TextBlock Text="{Binding BatteryText}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Status}" Value="Attention">
                    <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource AccentYellowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Lost">
                    <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource AccentRedBrush}" />
                    <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="Root"
                CornerRadius="8"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                Padding="6,5"
                ToolTip="{Binding StatusLine}"
                Effect="{DynamicResource PanelShadow}"
                MouseLeftButtonDown="OnRootMouseDown">
            <DockPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="6,0,0,0">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE72C;"
                            ToolTip="Обновить сейчас"
                            Click="OnRefreshClick" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE8BB;"
                            ToolTip="Свернуть в трей"
                            Margin="2,0,0,0"
                            Click="OnHideClick" />
                </StackPanel>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="560">
                        <ItemsControl ItemsSource="{Binding Devices}"
                                      ItemTemplate="{StaticResource DeviceCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="Устройства не найдены"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="20,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDevices}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

            </DockPanel>
        </Border>

        <tb:TaskbarIcon x:Name="Tray"
                        IconSource="{StaticResource TrayIconImage}"
                        ToolTipText="GearHub — заряд устройств"
                        TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Показать / скрыть" Click="OnToggleWindowClick" />
                    <MenuItem Header="Обновить" Click="OnRefreshClick" />
                    <Separator />
                    <MenuItem Header="Выход" Click="OnExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
