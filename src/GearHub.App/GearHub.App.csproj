<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>GearHub</AssemblyName>
    <RootNamespace>GearHub.App</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>Assets\GearHub.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GearHub.Core\GearHub.Core.csproj" />
    <ProjectReference Include="..\GearHub.Providers.Windows\GearHub.Providers.Windows.csproj" />
  </ItemGroup>

</Project>
